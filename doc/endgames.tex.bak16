\addplot[kbbk, thick, mark=*, mark size=1.1] coordinates {
(4,9) (5,13) (6,19) (7,25) (8,31) (9,35) (10,43) (11,49) (12,57) (13,63)
(14,71) (15,75) (16,85) (17,93)};
\addlegendentry{both on white squares --- bends}
\addplot[kbbk!50, thick, dashed, mark=square*, mark size=1.1] coordinates {
(4,7) (5,13) (6,17) (7,21) (8,25) (9,29) (10,33) (11,37) (12,39) (13,43)
(14,47) (15,51) (16,55) (17,59)};
