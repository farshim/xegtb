\addplot[knnnk, thin, densely dashdotted, mark=diamond*, mark size=1.6] coordinates {
(3,13.333333) (4,89.881434) (5,95.235554) (6,97.096036) (7,98.108951) (8,98.726549)
(9,99.122775) (10,99.383528) (11,99.55751) (12,99.675842) (13,99.757919) (14,99.815985)};
