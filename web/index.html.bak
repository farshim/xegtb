<!doctype html>
<meta charset="utf-8">
<title>xegtb -- endgame tablebases on an n x n board</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="style.css">

<header>
  <h1>Endgame tablebases on an <i>n</i> &times; <i>n</i> board</h1>
  <p>
    Every configuration the solver knows, solved on demand and shown as a board with
    every legal move priced by depth to mate. Pick one; the board size is a slider on
    the next page. The list below is generated by the server from the catalogue in
    <code>src/explore.cpp</code>, so a configuration added there appears here by itself &mdash; and above it,
    everything the table store actually holds, which is a great deal more.
  </p>
</header>

<main>
  <section id="summary">
    <h2 class="group">What has been solved</h2>
    <div id="sum" class="busy">reading the statistics</div>
  </section>
  <section id="featured">
    <h2 class="group">What the statistics found</h2>
    <div id="feat" class="busy">looking at the statistics</div>
  </section>
  <section id="ondisk">
    <h2 class="group">What is on the drive</h2>
    <div id="disk" class="busy">reading the store</div>
  </section>
  <div id="out" class="busy">loading the catalogue</div>
</main>

<script>
// The glyph a family's men are drawn with, worked out from the label: "KKK vs K",
// "KQKBB", "RR vs R".  Only decoration -- the board gets its men from the server.
const GLYPH = { K: "♚", Q: "♛", R: "♜", B: "♝", N: "♞" };

function glyphsFor(f) {
  const s = f.label.replace(/\(.*\)/, "").trim();
  let white = "", black = "";
  if (s.includes(" vs ")) {
    const [w, b] = s.split(" vs ");
    white = w.trim(); black = b.trim();
  } else {
    // "KQKBB": White's men, then Black's, split at the second K.
    const first = s.indexOf("K");
    const second = s.indexOf("K", first + 1);
    if (second < 0) { white = s; black = ""; }
    else { white = s.slice(0, second); black = s.slice(second); }
  }
  const draw = (t, cls) =>
    [...t].filter(c => GLYPH[c]).map(c => `<span class="man ${cls}">${GLYPH[c]}</span>`).join("");
  return draw(white, "w") + ' <span style="opacity:.45">vs</span> ' + draw(black, "b");
}

// The men of a statistics row's config, which is spelled "KKvKK" / "RRvR":
// White's letters, a lower-case v, Black's.  Split there rather than reusing
// glyphsFor, whose "second K" rule is for the mating-rule labels.
function glyphsForConfig(cfg) {
  const [w, b] = cfg.split("v");
  const draw = (t, cls) =>
    [...(t || "")].filter(c => GLYPH[c]).map(c => `<span class="man ${cls}">${GLYPH[c]}</span>`).join("");
  return draw(w, "w") + ' <span style="opacity:.45">vs</span> ' + draw(b, "b");
}

// The interesting positions, taken from the statistics file rather than from
// anything solved here: the server reads it per request, so a sweep running
// beside the server shows up on a reload.  The section is always present; with
// no statistics to read it says how to make some rather than disappearing.
fetch("api/interesting")
  .then(r => r.json())
  .then(d => {
    // The summary first: what the collection contains, counted by the server
    // from the same statistics file the positions come from.
    const sum = document.getElementById("sum");
    sum.className = "";
    const S = d.summary;
    if (S && S.rows) {
      const big = (x) => x.toLocaleString();
      const sci = (x) => x >= 1e9 ? (x / 1e9).toFixed(1) + " billion" : big(x);
      sum.innerHTML = `
        <div class="cards">
          <div class="card"><div class="label">${big(S.configurations)}</div>
            <div class="title">configurations</div>
            <div class="blurb">distinct material, each solved on every board in range</div></div>
          <div class="card"><div class="label">${big(S.rows)}</div>
            <div class="title">tables measured</div>
            <div class="blurb">one per configuration and board, n = ${S.minN}..${S.maxN}</div></div>
          <div class="card"><div class="label">${sci(S.positions)}</div>
            <div class="title">positions</div>
            <div class="blurb">legal placements counted across every table</div></div>
          <div class="card"><div class="label">${S.deepest} ply</div>
            <div class="title">deepest win</div>
            <div class="blurb">${S.deepestConfig} on ${S.deepestN} x ${S.deepestN}; ${big(S.alwaysWon)} materials are won from every placement</div></div>
        </div>
        <p class="sub" style="margin-top:14px">` +
        S.families.map(f => `${f.name}: ${big(f.rows)}`).join(" &middot; ") +
        `</p>
        <p class="sub">` + [
          S.shrinking ? `${big(S.shrinking)} materials whose win gets SHORTER on a bigger board` : "",
          S.neverWon ? `${big(S.neverWon)} White never wins on any board` : "",
          S.reversals ? `${big(S.reversals)} won often but never from a quiet position` : "",
        ].filter(x => x).join(" &middot; ") + `</p>
        <p class="sub">measured under both rule sets separately: ` +
        `${big(S.mateRows || 0)} normal-chess tables, ` +
        `${big(S.captureRows || 0)} capture-rules tables</p>`;
    } else {
      sum.innerHTML = '<p class="sub">No statistics file is loaded. Start the server with '
        + '<code>--stats FILE</code> to see what has been solved.</p>';
    }

    const feat = document.getElementById("feat");
    feat.className = "";
    if (!d.positions || !d.positions.length) {
      feat.innerHTML = '<p class="sub">No statistics to draw on yet. Generate some with '
        + '<code>egtb kings --white W --black B --min 3 --max N --stats-csv FILE</code> '
        + 'and start the server with <code>--stats FILE</code>; the positions the '
        + 'statistics single out appear here.</p>';
      return;
    }
    // What each card is an example OF.  The server picks by category rather
    // than by one score, so the badge is the finding and the card is one
    // instance of it.
    const KIND = {
      deepest:  "deepest quiet win",
      shrinks:  "shorter on a bigger board",
      reversal: "no quiet win exists",
      never:    "White never wins it",
      always:   "won from every placement",
    };
    feat.innerHTML = `<div class="cards">
      ${d.positions.map(p => {
        // A card with no position names a configuration rather than a
        // placement: nothing is won there, so there is no winning position to
        // link to and the explorer chooses what to show.
        const href = "board.html?f=" + encodeURIComponent(p.family) + "&n=" + p.n
                   + (p.pos ? "&pos=" + encodeURIComponent(p.pos) + "&stm=" + p.stm : "");
        return `
        <a class="card" href="${href}">
          <div class="label">${p.config} &middot; n = ${p.n}</div>
          <div class="glyphs">${glyphsForConfig(p.config)}</div>
          <div class="title">${p.pos || "open it and see what the table holds"}</div>
          <div class="blurb">${p.why}</div>
          <div class="meta">
            <span class="tag ${p.rules === "capture" ? "cap" : "mate"}">${
              p.rules === "capture" ? "capture rules" : "normal chess"}</span>
            ${KIND[p.kind] ? `<span class="tag on">${KIND[p.kind]}</span>` : ""}
            <span class="tag">${p.positions.toLocaleString()} placements</span>
            ${p.deepest ? `<span class="tag">deepest ${p.deepest} ply</span>` : ""}
            ${p.deepestQuiet ? `<span class="tag">quiet ${p.deepestQuiet} ply</span>` : ""}
          </div>
        </a>`; }).join("")}
    </div>`;
  })
  .catch(e => {
    const feat = document.getElementById("feat");
    feat.className = "err";
    feat.textContent = "could not read the statistics: " + e;
  });

// The store, read from the directory rather than from the catalogue.  These
// two disagree by an order of magnitude: the catalogue is the couple of dozen
// configurations somebody wrote a sentence about, and the drive holds every
// one a sweep has ever written -- hundreds of them, each openable by the
// structured id the server gives here.  A page that showed only the catalogue
// would be hiding almost the whole collection.
function fmtBytes(b) {
  if (b >= 1e12) return (b / 1e12).toFixed(1) + " TB";
  if (b >= 1e9) return (b / 1e9).toFixed(1) + " GB";
  if (b >= 1e6) return (b / 1e6).toFixed(0) + " MB";
  return (b / 1e3).toFixed(0) + " kB";
}

fetch("api/store")
  .then(r => r.json())
  .then(d => {
    const box = document.getElementById("disk");
    box.className = "";
    if (!d.entries || !d.entries.length) {
      box.innerHTML = '<p class="sub">No store is configured. Start the server with '
        + '<code>--tables DIR</code> and every table in that directory is listed here, '
        + 'catalogued or not.</p>';
      return;
    }

    // Split by RULE SET first and by heading second.  The same material is a
    // different game under the two, and several of them are on the drive
    // twice -- KBBK and KBBK (capture) are different tables with different
    // answers -- so the two never share a list.
    const rulesets = [
      { key: "mate",    name: "Normal chess", blurb:
          "Win by checkmate. Black's king cannot be taken and stalemate is a draw." },
      { key: "capture", name: "Capture rules", blurb:
          "Every man can be taken, kings included; the game is won by taking the "
          + "opponent's last man, and with one king a side that comes to the single "
          + "change that stalemate is a loss." },
    ];
    for (const rs of rulesets) {
      rs.groups = [];
      for (const e of d.entries) {
        if ((e.rules === "capture" ? "capture" : "mate") !== rs.key) continue;
        let g = rs.groups.find(x => x.name === e.group);
        if (!g) rs.groups.push(g = { name: e.group, items: [] });
        g.items.push(e);
      }
      rs.count = rs.groups.reduce((a, g) => a + g.items.length, 0);
      rs.boards = rs.groups.reduce((a, g) =>
        a + g.items.reduce((b, e) => b + e.boards.length, 0), 0);
      rs.bytes = rs.groups.reduce((a, g) =>
        a + g.items.reduce((b, e) => b + e.bytes, 0), 0);
    }

    const row = (e) => `
      <div class="drow" data-k="${(e.label + " " + e.id).toLowerCase()}">
        <div class="dmat">
          <span class="dglyph">${glyphsFor(e)}</span>
          <span class="dlabel">${e.label}</span>
          ${e.listed ? '<span class="tag">catalogued</span>' : ""}
        </div>
        <div class="dsizes">${e.boards.map(n =>
          `<a class="chip" href="board.html?f=${encodeURIComponent(e.id)}&n=${n}">${n}</a>`).join("")}</div>
        <div class="dbytes">${fmtBytes(e.bytes)}</div>
      </div>`;

    box.innerHTML = `
      <p class="sub">
        ${d.configurations.toLocaleString()} configurations &middot;
        ${d.boards.toLocaleString()} solved boards &middot;
        ${d.files.toLocaleString()} files &middot;
        ${fmtBytes(d.bytes)} in <code>${d.dir}</code>.
        Every board size below is a table already written: clicking one reads it
        from the drive instead of solving it. The largest tables of the kings
        lattice still take a while to open, because the explorer scans one for
        the position to start on.
      </p>
      <input id="dfilter" class="filter" placeholder="filter -- KKK, vs NN, rook, mixed...">
      ${rulesets.filter(rs => rs.count).map(rs => `
        <div class="ruleset ${rs.key}">
          <h3>${rs.name}
            <span class="count">${rs.count} configurations &middot;
              ${rs.boards.toLocaleString()} boards &middot; ${fmtBytes(rs.bytes)}</span></h3>
          <p class="sub">${rs.blurb}</p>
          ${rs.groups.map(g => `
            <details class="dgroup" ${g.items.length <= 24 ? "open" : ""}>
              <summary>${g.name} <span class="count">${g.items.length}</span></summary>
              <div class="drows">${g.items.map(row).join("")}</div>
            </details>`).join("")}
        </div>`).join("")}`;

    // The filter opens every group while it has text in it, so a match cannot
    // hide inside a collapsed section.
    const f = document.getElementById("dfilter");
    f.addEventListener("input", () => {
      const q = f.value.trim().toLowerCase();
      for (const g of box.querySelectorAll(".dgroup")) {
        let shown = 0;
        for (const r of g.querySelectorAll(".drow")) {
          const hit = !q || r.dataset.k.includes(q);
          r.hidden = !hit;
          if (hit) ++shown;
        }
        g.hidden = shown === 0;
        if (q) g.open = true;
        g.querySelector(".count").textContent = shown;
      }
    });
  })
  .catch(e => {
    const box = document.getElementById("disk");
    box.className = "err";
    box.textContent = "could not read the store: " + e;
  });

fetch("api/families")
  .then(r => r.json())
  .then(d => {
    const out = document.getElementById("out");
    out.className = "";
    // The catalogue is split the same way the inventory above is: the rule set
    // first, the heading second.  KBBK and KBBK (capture) are the same men and
    // different games, and a list that interleaves them invites reading a
    // depth from one as though it belonged to the other.
    const sets = [
      { key: "mate", name: "Normal chess", groups: [] },
      { key: "capture", name: "Capture rules", groups: [] },
    ];
    for (const f of d.families) {
      const rs = sets.find(x => x.key === (f.rules === "capture" ? "capture" : "mate"));
      let g = rs.groups.find(x => x.name === f.group);
      if (!g) rs.groups.push(g = { name: f.group, items: [] });
      g.items.push(f);
    }

    out.innerHTML = sets.filter(rs => rs.groups.length).map(rs => `
      <h2 class="rulehead">${rs.name}</h2>
      ` + rs.groups.map(g => `
      <h2 class="group">${g.name}</h2>
      <div class="cards">
        ${g.items.map(f => `
          <a class="card" href="board.html?f=${encodeURIComponent(f.id)}&n=${f.defN}">
            <div class="label">${f.label}</div>
            <div class="glyphs">${glyphsFor(f)}</div>
            <div class="title">${f.title}</div>
            <div class="blurb">${f.blurb}</div>
            <div class="meta">
              <span class="tag">${f.rules === "capture" ? "capture rules" : "mating rules"}</span>
              <span class="tag">n = ${f.minN}..${f.maxN}</span>
              ${f.generated.length ? `<span class="tag on">on disk: ${f.generated.join(", ")}</span>` : ""}
            </div>
          </a>`).join("")}
      </div>`).join("")).join("");

    if (d.tablesDir) {
      const p = document.createElement("p");
      p.className = "sub";
      p.style.marginTop = "28px";
      p.textContent = "“on disk” marks the board sizes already solved and kept in "
                    + d.tablesDir + " — those open at once. Any other board is solved when you "
                    + "ask for it, and kept as well if it took long enough to be worth a file.";
      document.querySelector("main").appendChild(p);
    }
  })
  .catch(e => {
    document.getElementById("out").className = "err";
    document.getElementById("out").textContent = "could not reach the server: " + e;
  });
</script>
